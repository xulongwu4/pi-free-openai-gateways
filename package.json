{
  "name": "pi-openai-gateways",
  "version": "0.2.0",
  "description": "Free-model Kilo, AIHubMix, Cline, and TokenRouter providers for Pi",
  "type": "module",
  "keywords": ["pi-package", "pi-extension", "kilo", "aihubmix", "cline", "tokenrouter", "openai", "gateway"],
  "license": "MIT",
  "pi": {
    "extensions": ["./index.ts"]
  },
  "exports": {
    ".": "./index.ts",
    "./gateway": "./gateway.ts",
    "./providers": "./providers.ts"
  },
  "files": ["index.ts", "gateway.ts", "providers.ts", "README.md"],
  "scripts": {
    "test": "node --experimental-strip-types --test index.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.3",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
